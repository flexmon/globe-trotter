# Mapbox Access Token (used by the Mapbox basemap provider AND the geocoder).
# Required if basemap.provider is 'mapbox' (default) OR if you want the
# location-search widget to work regardless of which basemap provider is active.
# Get yours free at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Google Maps Platform API key. Used by:
#  - Map Tiles API       (basemap.provider: google) — requires Map Tiles API enabled
#  - Places API (New)    (geocoder when Mapbox is unavailable, or when basemap.geocoderProvider: google)
#                          — requires Places API (New) enabled in Cloud Console
# Both APIs can share the same key. Enable them at https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# FlexDB proxy target for the dev server (/api proxy).
# Override to point at a different FlexDB instance (e.g., staging, local).
FLEXDB_URL=http://localhost:8090

# Infrastructure & Deployment Settings (used by .agents skills & deployment workflows)
GCP_PROJECT_DEV=your-gcp-project-dev
GCP_PROJECT_PROD=your-gcp-project-prod
GCS_BUCKET_DEV=your-gcs-bucket-dev
GCS_BUCKET_PROD=your-gcs-bucket-prod
GCS_CDN_HOST=cdn.example.com
GKE_CLUSTER_DEV=your-gke-cluster-dev
GKE_CLUSTER_PROD=your-gke-cluster-prod
